{
  "name": "dsh-desktop-unified",
  "productName": "DeepSeek Harness",
  "description": "Desktop shell for DeepSeek Harness: downloads as an installer, runs the dsh web UI with Electron's embedded Node — no system Node or npm required.",
  "version": "1.4.0",
  "private": true,
  "author": "dsh-desktop-unified",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && electron .",
    "pack": "tsc && electron-builder",
    "dist:mac": "tsc && electron-builder --mac",
    "dist:win": "tsc && electron-builder --win",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dsh": {
    "upstream": "@deepseek-ai/dsh",
    "upstreamVersion": "0.1.2-rc.1",
    "desktopLine": "1.4.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-attachment": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-authorization": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-code-runtime": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-fs": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-hook-protocol": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-jobs": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-output-retention": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-shell": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-spill": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-util-time": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-workflow": "^0.1.2-rc.1",
    "@pnpm/exe": "11.22.0",
    "dsh-desktop-preset-transfer": "file:plugins/dsh-desktop-preset-transfer",
    "dsh-market-tools": "file:plugins/dsh-market-tools",
    "dsh-plugin-version-manager": "file:plugins/dsh-plugin-version-manager",
    "dsh-shell-control": "file:plugins/dsh-shell-control",
    "dsh-terminal": "file:plugins/dsh-terminal",
    "dshmarket": "file:vendor/dshmarket",
    "electron-updater": "^6.6.2",
    "fflate": "^0.8.3",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.5.8",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "vitest": "^2.0.0",
    "vue": "^3.5.41"
  }
}
